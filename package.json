{
  "name": "root",
  "type": "module",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint:js": "NODE_OPTIONS='--max-old-space-size=8192' eslint '{packages,examples}/**/*.{js,ts}'",
    "lint:sol": "solhint '{packages,examples}/*/{contracts,src}/**/*.sol'",
    "lint": "pnpm run '/^lint:(js|sol)/'",
    "lint:fix:js": "prettier --write '{packages,examples}/**/*.{js,ts}' && NODE_OPTIONS='--max-old-space-size=8192' eslint --fix '{packages,examples}/**/*.{js,ts}'",
    "lint:fix:sol": "prettier --write '{packages,examples}/*/{contracts,src}/**/*.sol' --plugin=prettier-plugin-solidity",
    "lint:fix": "pnpm run '/^lint:fix:(js|sol)/'",
    "clean": "pnpm -r --if-present run clean",
    "build": "pnpm run clean && pnpm -r --filter @usecannon/builder --filter @usecannon/cli --filter @usecannon/api run build",
    "build:website": "pnpm run clean && pnpm -r --filter @usecannon/builder --filter @usecannon/cli --filter @usecannon/api --filter @usecannon/website run build",
    "watch": "pnpm -r --parallel --filter @usecannon/builder --filter @usecannon/cli run watch",
    "version": "lerna version --no-private",
    "publish": "lerna publish from-package --no-private",
    "publish-alpha": "lerna publish from-package --no-private --preid alpha --dist-tag alpha",
    "test": "pnpm -r --if-present --filter './packages/**' --filter !@usecannon/repo run test",
    "docgen-md": "pnpm -r --if-present run docgen",
    "changeset": "changeset"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/usecannon/cannon.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "lerna": "^10.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^2.4.1",
    "solhint": "^6.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  },
  "license": "GNU GPL V3.0",
  "dependencies": {
    "@changesets/cli": "^3.0.3"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "version": "0.0.1"
}
